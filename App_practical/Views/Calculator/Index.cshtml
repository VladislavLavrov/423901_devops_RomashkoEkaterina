@{
    ViewData["Title"] = "Калькулятор";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial; margin: 40px; }
        form { margin: 20px 0; }
        input, select, button { padding: 8px; margin: 5px; font-size: 16px; }
        h2 { color: green; }
    </style>
</head>
<body>
    <h1>Калькулятор</h1>

    <form method="post" asp-controller="Calculator" asp-action="Index">
        @Html.AntiForgeryToken()
        <input type="text" name="number1" value="@ViewBag.number1" required />
        <select name="operation" required>
            <option value="Add">+</option>
            <option value="Subtract">-</option>
            <option value="Multiply">*</option>
            <option value="Divide">/</option>
        </select>
        <input type="text" name="number2" value="@ViewBag.number2" required />
        <input type="submit" value="Рассчитать" />
    </form>

    @if (ViewBag.Result != null)
    {
        <h2>Результат: @ViewBag.Result</h2>
    }

    <footer>
        <p>Ромашко Екатерина Валерьевна | НМТ-423901</p>
    </footer>
</body>
</html>