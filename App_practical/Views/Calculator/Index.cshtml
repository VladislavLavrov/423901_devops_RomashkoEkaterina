@{
    ViewData["Title"] = "Калькулятор";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial; margin: 40px; }
        form { margin: 20px 0; }
        input, select, button { padding: 8px; margin: 5px; font-size: 16px; }
        h2 { color: green; }
    </style>
</head>
<body>
    <h1>Калькулятор</h1>

    <form method="post" action="/Calculator/Calculate">
        <input type="number" name="num1" value="@ViewBag.Num1" step="any" required />
        
        <select name="operation" required>
            <option value="add">+</option>
            <option value="subtract">-</option>
            <option value="multiply">×</option>
            <option value="divide">÷</option>
        </select>
        
        <input type="number" name="num2" value="@ViewBag.Num2" step="any" required />
        
        <button type="submit">=</button>
    </form>

    @if (ViewBag.Result != null)
    {
        <h2>Результат: @ViewBag.Result</h2>
    }

    <footer>
        <p>Ромашко Екатерина Валерьевна | НМТ-423901</p>
    </footer>
</body>
</html>